{
  "version": 3,
  "kinds": ["signal", "bool"],
  "widgets": ["target", "property", "propbool", "propnum", "select", "number", "duration", "time", "moment", "weekday", "toggle", "text", "textarea", "routine", "flow", "var", "token", "scene", "color", "rooms", "button"],
  "categories": {
    "source": { "label": "Auslöser & Bedingungen", "icon": "bolt" },
    "logic": { "label": "Logik", "icon": "split" },
    "action": { "label": "Aktionen", "icon": "play" }
  },
  "roles": {
    "trigger": { "label": "Auslöser", "hint": "startet den Ablauf" },
    "condition": { "label": "Bedingung", "hint": "wird von Wenn/Dann geprüft" }
  },
  "properties": [
    { "id": "on", "label": "Ein/Aus", "type": "bool", "yes": "an", "no": "aus" },
    { "id": "motion", "label": "Bewegung", "type": "bool", "yes": "Bewegung erkannt", "no": "keine Bewegung" },
    { "id": "open", "label": "Fenster/Tür", "type": "bool", "yes": "offen", "no": "geschlossen" },
    { "id": "alarm", "label": "Alarm", "type": "bool", "yes": "Alarm", "no": "kein Alarm" },
    { "id": "present", "label": "Anwesenheit", "type": "bool", "yes": "anwesend", "no": "abwesend" },
    { "id": "playing", "label": "Wiedergabe", "type": "bool", "yes": "spielt", "no": "spielt nicht" },
    { "id": "muted", "label": "Stumm", "type": "bool", "yes": "stumm", "no": "Ton an" },
    { "id": "temperature", "label": "Temperatur", "type": "number", "unit": "°C", "min": -30, "max": 60, "step": 0.5, "default": 20 },
    { "id": "target", "label": "Solltemperatur", "type": "number", "unit": "°C", "min": 5, "max": 30, "step": 0.5, "default": 20 },
    { "id": "humidity", "label": "Luftfeuchte", "type": "number", "unit": "%", "min": 0, "max": 100, "step": 1, "default": 60 },
    { "id": "brightness", "label": "Helligkeit", "type": "number", "unit": "%", "min": 0, "max": 100, "step": 1, "default": 50 },
    { "id": "illuminance", "label": "Umgebungslicht", "type": "number", "unit": "lx", "min": 0, "max": 100000, "step": 1, "default": 30 },
    { "id": "position", "label": "Rollladen-Position", "type": "number", "unit": "%", "min": 0, "max": 100, "step": 1, "default": 50 },
    { "id": "valve", "label": "Ventilöffnung", "type": "number", "unit": "%", "min": 0, "max": 100, "step": 1, "default": 10 },
    { "id": "battery", "label": "Batterie", "type": "number", "unit": "%", "min": 0, "max": 100, "step": 1, "default": 20 },
    { "id": "power_w", "label": "Leistung", "type": "number", "unit": "W", "min": 0, "max": 4000, "step": 1, "default": 10 },
    { "id": "volume", "label": "Lautstärke", "type": "number", "unit": "%", "min": 0, "max": 100, "step": 1, "default": 30 }
  ],
  "nodes": [
    { "type": "presence", "category": "source", "label": "Anwesenheit", "icon": "home",
      "roles": {
        "trigger": { "outputs": [{ "id": "out", "kind": "signal", "label": "beginnt" }, { "id": "end", "kind": "signal", "label": "endet" }] },
        "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "state", "widget": "select", "label": "Status", "default": "AWAY", "options": [["PRESENT", "Zuhause"], ["AWAY", "Abwesend"]] }],
      "summary": "{state}",
      "help": "Auslöser: startet, wenn der Status beginnt (z. B. alle gehen) oder endet. Bedingung: erfüllt, solange der Status gilt." },

    { "type": "play", "category": "source", "label": "Play", "icon": "play",
      "roles": {
        "trigger": { "outputs": [{ "id": "out", "kind": "signal" }] },
        "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "label", "widget": "text", "label": "Beschriftung", "default": "Los", "max": 30 }],
      "summary": "{label}",
      "help": "Auslöser: ein Knopf in der Flow-Liste und hier im Editor. Bedingung: erfüllt, wenn der laufende Durchgang per Play gestartet wurde." },

    { "type": "scene", "category": "source", "label": "Szene", "icon": "palette",
      "roles": {
        "trigger": { "outputs": [{ "id": "out", "kind": "signal", "label": "aktiviert" }, { "id": "end", "kind": "signal", "label": "beendet" }] },
        "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "scene", "widget": "scene", "label": "Szene (leer = jede)", "optional": true },
                 { "key": "rooms", "widget": "rooms", "label": "Räume (leer = alle)", "default": [] }],
      "summary": "{scene} · {rooms}",
      "help": "Auslöser: startet, wenn die Szene in einem der Räume aktiviert bzw. beendet wird. Bedingung: erfüllt, solange sie dort aktiv ist." },

    { "type": "time", "category": "source", "label": "Zeitpunkt", "icon": "clock",
      "roles": {
        "trigger": { "outputs": [{ "id": "out", "kind": "signal" }] },
        "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "at", "widget": "moment", "label": "Um", "default": "18:00", "when": { "role": "trigger" } },
                 { "key": "from", "widget": "moment", "label": "Von", "default": "18:00", "when": { "role": "condition" } },
                 { "key": "to", "widget": "moment", "label": "Bis", "default": "23:00", "when": { "role": "condition" } },
                 { "key": "days", "widget": "weekday", "label": "Wochentage", "default": [0, 1, 2, 3, 4, 5, 6] }],
      "summary": { "trigger": "{at} · {days}", "condition": "{from} bis {to} · {days}" },
      "help": "Auslöser: startet an den gewählten Tagen zur Uhrzeit oder zu Sonnenauf-/-untergang (mit Versatz). Bedingung: erfüllt im Zeitraum von-bis, auch über Mitternacht. Von = Bis bedeutet ganzer Tag. Sonnenzeiten kommen aus der Adresse im Grundriss." },

    { "type": "device_signal", "category": "source", "label": "Gerätesignal", "icon": "battery",
      "roles": {
        "trigger": { "outputs": [{ "id": "out", "kind": "signal", "label": "tritt auf" }] },
        "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "signal", "widget": "select", "label": "Signal", "default": "battery", "options": [["battery", "Batterie schwach"], ["error", "Gerätefehler"], ["alarm", "Alarm"]] },
                 { "key": "target", "widget": "target", "label": "Geräte (leer = alle)", "optional": true, "empty": "alle Geräte" },
                 { "key": "below", "widget": "number", "label": "Schwach unter", "unit": "%", "default": 15, "min": 1, "max": 90, "step": 1, "when": { "signal": "battery" } }],
      "summary": "{signal} · {target}",
      "help": "Auslöser: startet für jedes Gerät, bei dem das Signal neu auftritt ({device} nennt das Gerät). Bedingung: erfüllt, solange das Signal bei mindestens einem der Geräte anliegt." },

    { "type": "device_state", "category": "source", "label": "Gerätestatus", "icon": "device",
      "roles": {
        "trigger": { "outputs": [{ "id": "out", "kind": "signal", "label": "beginnt" }, { "id": "end", "kind": "signal", "label": "endet" }] },
        "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "target", "widget": "target", "label": "Geräte, Gruppen oder Räume", "props": true },
                 { "key": "prop", "widget": "property", "label": "Eigenschaft" },
                 { "key": "is", "widget": "propbool", "label": "Zustand", "default": "yes", "when": { "@ptype": "bool" } },
                 { "key": "op", "widget": "select", "label": "Vergleich", "default": "gt", "options": [["gt", "über"], ["lt", "unter"], ["eq", "genau"]], "when": { "@ptype": "number" } },
                 { "key": "value", "widget": "propnum", "label": "Wert", "when": { "@ptype": "number" } },
                 { "key": "match", "widget": "select", "label": "Bei mehreren Geräten", "default": "any", "options": [["any", "mindestens eins"], ["all", "alle"]] },
                 { "key": "hold_on", "widget": "duration", "label": "beginnt erst nach (0 = sofort)", "default": 0, "min": 0, "max": 86400, "when": { "role": "trigger" } },
                 { "key": "hold_off", "widget": "duration", "label": "endet erst nach (0 = sofort)", "default": 0, "min": 0, "max": 86400, "when": { "role": "trigger" } },
                 { "key": "band", "widget": "number", "label": "Schaltschwelle (Abstand zum Zurückschalten)", "default": 0, "min": 0, "max": 50, "step": 0.5, "pro": true, "advanced": true, "when": { "@ptype": "number" } }],
      "summary": { "trigger": "{target} · {prop} {is} {op} {value} · {hold_on} {hold_off}", "condition": "{target} · {prop} {is} {op} {value}" },
      "help": "Beschreibt einen Zustand, z. B. Bewegung erkannt, Fenster offen oder Temperatur über 21 °C. Auslöser: beginnt startet, sobald der Zustand eintritt, endet, sobald er vorbei ist. Mit endet erst nach bleibt z. B. das Licht an, solange Bewegung da ist, und geht erst nach der eingestellten Zeit ohne Bewegung aus. Bedingung: erfüllt, solange der Zustand gilt. Die Eigenschaften kommen von den gewählten Geräten." },

    { "type": "button", "category": "source", "label": "Taster", "icon": "button",
      "roles": {
        "trigger": { "outputs": [{ "id": "out", "kind": "signal", "label": "gedrückt" }] },
        "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "target", "widget": "target", "label": "Taster oder Fernbedienung", "buttons": true, "when": { "role": "trigger" } },
                 { "key": "button", "widget": "button", "label": "Taste", "optional": true, "when": { "role": "trigger" } },
                 { "key": "press", "widget": "select", "label": "Druck", "default": "short", "options": [["short", "kurz"], ["long", "lang"], ["double", "doppelt"], ["any", "beliebig"]], "when": { "role": "trigger" } }],
      "summary": { "trigger": "{target} · {button} · {press}", "condition": "per Taster gestartet" },
      "help": "Auslöser: startet, sobald an einem der gewählten Taster die Taste so gedrückt wird (kurz, lang oder doppelt – was der Taster unterscheidet). Ein Druck ist ein Ereignis: er löst genau einmal aus und wird nie nachgeholt. Bedingung: erfüllt, wenn der laufende Durchgang per Taster gestartet wurde." },

    { "type": "webhook", "category": "source", "label": "Webhook", "icon": "link", "pro": true,
      "roles": {
        "trigger": { "outputs": [{ "id": "out", "kind": "signal" }] },
        "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "token", "widget": "token", "label": "Adresse", "when": { "role": "trigger" } }],
      "summary": { "trigger": "POST /api/flows/hook/…", "condition": "per Webhook gestartet" },
      "help": "Auslöser: startet beim Aufruf der Adresse (nur im Heimnetz/VPN erreichbar; wer sie kennt, kann den Flow starten). Bedingung: erfüllt, wenn der laufende Durchgang per Webhook gestartet wurde." },

    { "type": "flow_error", "category": "source", "label": "Flow-Fehler", "icon": "warn", "pro": true,
      "roles": {
        "trigger": { "outputs": [{ "id": "out", "kind": "signal" }] },
        "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "flow", "widget": "flow", "label": "Nur dieser Flow (leer = jeder)", "optional": true, "when": { "role": "trigger" } }],
      "summary": { "trigger": "{flow}", "condition": "durch Flow-Fehler gestartet" },
      "help": "Auslöser: startet, wenn ein anderer Flow scheitert. {trigger} = Name des Flows, {value} = Fehlertext. Bedingung: erfüllt, wenn der laufende Durchgang so gestartet wurde." },

    { "type": "interval", "category": "source", "label": "Intervall", "icon": "repeat", "pro": true,
      "roles": {
        "trigger": { "outputs": [{ "id": "out", "kind": "signal" }] },
        "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "every", "widget": "duration", "label": "Alle", "default": 900, "min": 10, "max": 86400, "when": { "role": "trigger" } },
                 { "key": "from", "widget": "time", "label": "Nur ab (optional)", "default": "" },
                 { "key": "to", "widget": "time", "label": "Nur bis (optional)", "default": "" }],
      "summary": { "trigger": "alle {every}", "condition": "{from} bis {to}" },
      "help": "Auslöser: startet regelmäßig, optional nur im Zeitraum. Bedingung: erfüllt innerhalb des Zeitraums." },

    { "type": "startup", "category": "source", "label": "Start", "icon": "power", "pro": true,
      "roles": {
        "trigger": { "outputs": [{ "id": "out", "kind": "signal" }] },
        "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "offset", "widget": "duration", "label": "Versatz", "default": 0, "min": 0, "max": 3600 }],
      "summary": { "trigger": "beim Start + {offset}", "condition": "läuft länger als {offset}" },
      "help": "Auslöser: einmal, wenn ComfyOS bereit ist bzw. dieser Flow eingeschaltet wird (plus Versatz). Bedingung: erfüllt, wenn ComfyOS länger als der Versatz läuft." },

    { "type": "reachable", "category": "source", "label": "Gerät online/offline", "icon": "offline", "pro": true,
      "roles": {
        "trigger": { "outputs": [{ "id": "out", "kind": "signal", "label": "tritt ein" }] },
        "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "state", "widget": "select", "label": "Zustand", "default": "offline", "options": [["offline", "offline"], ["online", "online"]] },
                 { "key": "target", "widget": "target", "label": "Geräte (leer = alle)", "optional": true, "empty": "alle Geräte" }],
      "summary": "{target} · {state}",
      "help": "Auslöser: startet für jedes Gerät, das offline geht bzw. wieder online kommt ({device} nennt es). Bedingung: erfüllt, solange mindestens eines der Geräte in diesem Zustand ist." },

    { "type": "stale", "category": "source", "label": "Keine Änderung seit", "icon": "pause", "pro": true,
      "roles": { "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "target", "widget": "target", "label": "Geräte" },
                 { "key": "for", "widget": "duration", "label": "Seit mindestens", "default": 3600, "min": 60, "max": 604800 }],
      "summary": "{target} · {for}",
      "help": "Bedingung: erfüllt, wenn mindestens eines der Geräte so lange keinen neuen Wert gemeldet hat (eingefroren, Batterie leer?)." },

    { "type": "variable", "category": "source", "label": "Variable prüfen", "icon": "tag", "pro": true,
      "roles": {
        "trigger": { "outputs": [{ "id": "out", "kind": "signal", "label": "beginnt" }, { "id": "end", "kind": "signal", "label": "endet" }] },
        "condition": { "outputs": [{ "id": "val", "kind": "bool", "label": "ja/nein" }] } },
      "fields": [{ "key": "name", "widget": "var", "label": "Variable", "default": "Urlaub" },
                 { "key": "cmp", "widget": "select", "label": "Vergleich", "default": "on",
                   "options": [["on", "ist an (Ja)"], ["off", "ist aus (Nein)"], ["gt", "Zahl über"], ["lt", "Zahl unter"], ["eq", "Zahl gleich"], ["text", "Text gleich"], ["contains", "Text enthält"]] },
                 { "key": "value", "widget": "number", "label": "Zahl", "default": 0, "step": 1, "when": { "cmp": ["gt", "lt", "eq"] } },
                 { "key": "text", "widget": "text", "label": "Text", "default": "", "max": 120, "when": { "cmp": ["text", "contains"] } }],
      "summary": "{name} {cmp} {value} {text}",
      "help": "Variablen merken sich Ja/Nein, eine Zahl oder einen Text über alle Flows hinweg (gesetzt mit Variable setzen). Auslöser: startet, wenn der Vergleich wahr wird bzw. endet. Bedingung: erfüllt, solange er wahr ist." },

    { "type": "when", "category": "logic", "label": "Wenn / Dann", "icon": "split",
      "inputs": [{ "id": "in", "kind": "signal" }, { "id": "c", "kind": "bool", "grow": true, "max": 10, "label": "Bedingung" }],
      "outputs": [{ "id": "yes", "kind": "signal", "label": "dann" }, { "id": "no", "kind": "signal", "label": "sonst" }],
      "fields": [{ "key": "match", "widget": "select", "label": "Erfüllt sein müssen", "default": "all", "options": [["all", "alle"], ["any", "mindestens eine"], ["one", "genau eine"]] }],
      "summary": "{match}",
      "help": "Kommt ein Signal an, werden die angeschlossenen Bedingungen geprüft: erfüllt geht es bei dann weiter, sonst bei sonst. Für jede Bedingung erscheint ein neuer freier Anschluss. Ohne Bedingung geht es immer bei dann weiter." },

    { "type": "not", "category": "logic", "label": "Nicht", "icon": "x",
      "inputs": [{ "id": "c", "kind": "bool", "label": "Bedingung" }],
      "outputs": [{ "id": "val", "kind": "bool", "label": "umgekehrt" }],
      "fields": [], "summary": "kehrt die Bedingung um",
      "help": "Dreht eine Bedingung um: aus erfüllt wird nicht erfüllt und umgekehrt." },

    { "type": "random", "category": "logic", "label": "Zufall", "icon": "dice", "pro": true,
      "inputs": [{ "id": "in", "kind": "signal" }],
      "outputs": [{ "id": "o", "kind": "signal", "count": "n", "count_when": { "mode": "pick" }, "max": 10 }],
      "fields": [{ "key": "mode", "widget": "select", "label": "Art", "default": "pick", "options": [["pick", "einer von mehreren Wegen"], ["chance", "mit Wahrscheinlichkeit"], ["delay", "zufällig verzögern"]] },
                 { "key": "n", "widget": "number", "label": "Anzahl Wege", "default": 2, "min": 2, "max": 10, "step": 1, "when": { "mode": "pick" } },
                 { "key": "p", "widget": "number", "label": "Wahrscheinlichkeit", "unit": "%", "default": 50, "min": 0, "max": 100, "step": 5, "when": { "mode": "chance" } },
                 { "key": "min", "widget": "duration", "label": "Mindestens", "default": 60, "min": 0, "max": 86400, "when": { "mode": "delay" } },
                 { "key": "max", "widget": "duration", "label": "Höchstens", "default": 900, "min": 0, "max": 86400, "when": { "mode": "delay" } }],
      "summary": "{mode} {n} {p} {min} {max}",
      "help": "Einer von mehreren Wegen: das Signal geht an genau einen der verbundenen Ausgänge. Mit Wahrscheinlichkeit: es geht nur manchmal weiter. Zufällig verzögern: es geht nach einer zufälligen Zeit weiter." },

    { "type": "rate", "category": "logic", "label": "Drosseln / Entprellen", "icon": "hourglass", "pro": true,
      "inputs": [{ "id": "in", "kind": "signal" }], "outputs": [{ "id": "out", "kind": "signal" }],
      "fields": [{ "key": "mode", "widget": "select", "label": "Art", "default": "throttle", "options": [["throttle", "Drosseln"], ["debounce", "Entprellen"]] },
                 { "key": "wait", "widget": "duration", "label": "Zeit", "default": 300, "min": 1, "max": 86400 }],
      "summary": "{mode} {wait}",
      "help": "Drosseln: lässt höchstens ein Signal je Zeitraum durch. Entprellen: gibt erst weiter, wenn so lange kein neues Signal kam." },

    { "type": "toggle", "category": "logic", "label": "Umschalter", "icon": "toggle", "pro": true,
      "inputs": [{ "id": "in", "kind": "signal" }],
      "outputs": [{ "id": "a", "kind": "signal", "label": "A" }, { "id": "b", "kind": "signal", "label": "B" }],
      "fields": [], "summary": "A ↔ B",
      "help": "Jedes Signal wechselt zwischen Ausgang A und B – das erste geht an A." },

    { "type": "loop", "category": "logic", "label": "Solange", "icon": "repeat", "pro": true,
      "inputs": [{ "id": "in", "kind": "signal" }, { "id": "c", "kind": "bool", "grow": true, "max": 10, "label": "Bedingung", "when": { "mode": "while" } }],
      "outputs": [{ "id": "loop", "kind": "signal", "label": "je Runde" }, { "id": "out", "kind": "signal", "label": "danach" }],
      "fields": [{ "key": "mode", "widget": "select", "label": "Wiederholen", "default": "while", "options": [["while", "solange die Bedingungen erfüllt sind"], ["times", "feste Anzahl"]] },
                 { "key": "times", "widget": "number", "label": "Runden", "default": 3, "min": 1, "max": 100, "step": 1, "when": { "mode": "times" } },
                 { "key": "gap", "widget": "duration", "label": "Abstand zwischen den Runden", "default": 5, "min": 0, "max": 3600 }],
      "summary": "{mode} {times} · alle {gap}",
      "help": "Wiederholt den Weg je Runde, solange alle angeschlossenen Bedingungen erfüllt sind (bzw. eine feste Anzahl), danach geht es bei danach weiter. Die Schleife läuft im Hintergrund und hat keine Zeitgrenze: sie endet erst, wenn die Bedingung nicht mehr gilt oder der Flow ausgeschaltet wird. Zwischen zwei Runden liegt mindestens eine Sekunde. Ein neues Signal während der Schleife wird ignoriert. In Texten stehen {index} und {count} bereit." },

    { "type": "hold", "category": "logic", "label": "Haltezeit", "icon": "hourglass", "pro": true,
      "inputs": [{ "id": "c", "kind": "bool", "grow": true, "max": 10, "label": "Bedingung" }],
      "outputs": [{ "id": "out", "kind": "signal", "label": "beginnt" }, { "id": "end", "kind": "signal", "label": "endet" }],
      "fields": [{ "key": "hold_on", "widget": "duration", "label": "beginnt erst nach", "default": 300, "min": 0, "max": 86400 },
                 { "key": "hold_off", "widget": "duration", "label": "endet erst nach (0 = sofort)", "default": 0, "min": 0, "max": 86400 }],
      "summary": "{hold_on} {hold_off}",
      "help": "Macht aus Bedingungen einen Auslöser: beginnt startet, sobald alle angeschlossenen Bedingungen so lange ununterbrochen erfüllt sind; endet, sobald sie es nicht mehr sind." },

    { "type": "set_presence", "category": "action", "label": "Anwesenheit setzen", "icon": "home",
      "inputs": [{ "id": "in", "kind": "signal" }], "outputs": [{ "id": "out", "kind": "signal", "label": "danach" }],
      "fields": [{ "key": "state", "widget": "select", "label": "Auf", "default": "AWAY", "options": [["PRESENT", "Zuhause"], ["AWAY", "Abwesend"]] }],
      "summary": "→ {state}" },

    { "type": "set_scene", "category": "action", "label": "Szene", "icon": "palette",
      "inputs": [{ "id": "in", "kind": "signal" }], "outputs": [{ "id": "out", "kind": "signal", "label": "danach" }],
      "fields": [{ "key": "do", "widget": "select", "label": "Aktion", "default": "start", "options": [["start", "starten"], ["stop", "beenden"]] },
                 { "key": "scene", "widget": "scene", "label": "Szene", "when": { "do": "start" } },
                 { "key": "target", "widget": "target", "label": "Wo (leer = alle Räume)", "optional": true, "empty": "alle Räume", "kinds": ["light"] },
                 { "key": "restore", "widget": "toggle", "label": "Licht wie vor der Szene", "default": true, "when": { "do": "stop" } }],
      "summary": "{scene} {do} · {target}",
      "help": "Startet eine Szene in Räumen, Gerätegruppen oder für einzelne Lampen – oder beendet die aktiven Szenen dort (auf Wunsch mit dem Licht von davor)." },

    { "type": "set_device", "category": "action", "label": "Gerät steuern", "icon": "power",
      "inputs": [{ "id": "in", "kind": "signal" }], "outputs": [{ "id": "out", "kind": "signal", "label": "danach" }],
      "fields": [{ "key": "do", "widget": "select", "label": "Was", "default": "switch",
                   "options": [["switch", "Ein/Aus schalten"], ["light", "Licht einstellen"], ["dim", "Heller / dunkler"], ["temp", "Temperatur"], ["cover", "Rollladen"]] },
                 { "key": "target", "widget": "target", "label": "Geräte, Gruppen oder Räume",
                   "kinds_by": { "key": "do", "map": { "switch": ["light", "switch"], "light": ["light"], "dim": ["light"], "temp": ["thermostat"], "cover": ["cover"] } },
                   "wide_kinds": ["light"], "all": "Alle Lampen", "all_when": { "do": "switch" },
                   "hint": "Räume und Alle Lampen schalten nur Lampen – Steckdosen wählst du einzeln oder über eine Gruppe." },
                 { "key": "to", "widget": "select", "label": "Schalten", "default": "on", "options": [["on", "an"], ["off", "aus"], ["toggle", "umschalten"]], "when": { "do": "switch" } },
                 { "key": "light_mode", "widget": "select", "label": "Art", "default": "white", "options": [["white", "Weißton"], ["color", "Farbe"], ["bri", "nur Helligkeit"], ["effect", "Effekt"]], "when": { "do": "light" } },
                 { "key": "kelvin", "widget": "number", "label": "Weißton", "unit": "K", "default": 2700, "min": 2000, "max": 6500, "step": 100, "when": { "do": "light", "light_mode": "white" } },
                 { "key": "color", "widget": "color", "label": "Farbe", "default": "#ff8a2a", "when": { "do": "light", "light_mode": "color" } },
                 { "key": "effect", "widget": "select", "label": "Effekt", "default": "candle", "when": { "do": "light", "light_mode": "effect" },
                   "options": [["candle", "Kerze"], ["fire", "Kaminfeuer"], ["sparkle", "Funkeln"], ["glisten", "Glitzern"], ["opal", "Opal"], ["prism", "Prisma"], ["no_effect", "Effekt aus"]] },
                 { "key": "brightness", "widget": "number", "label": "Helligkeit", "unit": "%", "default": 80, "min": 1, "max": 100, "step": 1, "when": { "do": "light" } },
                 { "key": "step", "widget": "number", "label": "Ändern um", "unit": "%", "default": 20, "min": -100, "max": 100, "step": 5, "when": { "do": "dim" } },
                 { "key": "temp_mode", "widget": "select", "label": "Art", "default": "abs", "options": [["abs", "auf Wert"], ["delta", "um ± ändern"]], "when": { "do": "temp" } },
                 { "key": "temp", "widget": "number", "label": "Temperatur", "unit": "°C", "default": 18, "min": -10, "max": 30, "step": 0.5, "when": { "do": "temp" } },
                 { "key": "cover", "widget": "select", "label": "Bewegung", "default": "down", "options": [["up", "öffnen"], ["down", "schließen"], ["stop", "anhalten"], ["position", "auf Position"]], "when": { "do": "cover" } },
                 { "key": "position", "widget": "number", "label": "Position (0 = offen, 100 = zu)", "unit": "%", "default": 50, "min": 0, "max": 100, "step": 5, "when": { "do": "cover", "cover": "position" } }],
      "summary": "{target} · {to} {light_mode} {kelvin} {color} {effect} {brightness} {step} {temp_mode} {temp} {cover} {position}",
      "help": "Schaltet oder stellt die gewählten Geräte. Räume und Gruppen meinen immer alle passenden Geräte darin. Lampen, die Farbe oder Weißton nicht können, bekommen das Nächstmögliche. Gesperrte Geräte werden übersprungen." },

    { "type": "playback", "category": "action", "label": "Wiedergabe", "icon": "media",
      "inputs": [{ "id": "in", "kind": "signal" }], "outputs": [{ "id": "out", "kind": "signal", "label": "danach" }],
      "fields": [
        { "key": "do", "widget": "select", "label": "Was", "default": "play", "options": [["play", "abspielen"], ["pause", "pausieren"], ["toggle", "abspielen / pausieren"], ["volume", "Lautstärke setzen"], ["favorite", "Favorit starten"], ["next", "nächster Titel"], ["previous", "vorheriger Titel"]] },
        { "key": "target", "widget": "target", "label": "Lautsprecher, Gruppen oder Räume", "kinds": ["media"] },
        { "key": "volume", "widget": "number", "label": "Lautstärke", "unit": "%", "default": 20, "min": 0, "max": 100, "step": 1, "when": { "do": "volume" } },
        { "key": "favorite", "widget": "text", "label": "Name des Favoriten", "default": "", "max": 120, "when": { "do": "favorite" } }
      ],
      "summary": "{target} · {do} {volume} {favorite}",
      "help": "Steuert Lautsprecher: abspielen, pausieren, Lautstärke setzen, einen Favoriten starten oder den Titel wechseln. Der Favorit heißt wie in der Auswahl der Lautsprecher-Kachel. Gesperrte Geräte werden übersprungen." },

    { "type": "set_routine", "category": "action", "label": "Heizroutine", "icon": "flame",
      "inputs": [{ "id": "in", "kind": "signal" }], "outputs": [{ "id": "out", "kind": "signal", "label": "danach" }],
      "fields": [{ "key": "routine", "widget": "routine", "label": "Routine" }],
      "summary": "{routine} aktivieren" },

    { "type": "timer", "category": "action", "label": "Zeitschalter", "icon": "clock",
      "inputs": [{ "id": "in", "kind": "signal", "label": "Start" }, { "id": "cancel", "kind": "signal", "label": "Abbrechen" }],
      "outputs": [{ "id": "out", "kind": "signal", "label": "danach" }],
      "fields": [{ "key": "wait", "widget": "duration", "label": "Dauer", "default": 300, "min": 1, "max": 86400 },
                 { "key": "mode", "widget": "select", "label": "Kommt währenddessen ein neues Signal", "default": "restart",
                   "options": [["restart", "beginnt die Zeit von vorn"], ["extend", "wird die Zeit verlängert"], ["ignore", "wird es ignoriert"], ["each", "läuft es zusätzlich (einzeln)"]] }],
      "summary": "nach {wait}",
      "help": "Wartet die Dauer ab und gibt das Signal dann weiter. Abbrechen stoppt die laufende Zeit. Der Zeitschalter überlebt einen Neustart von ComfyOS." },

    { "type": "http", "category": "action", "label": "HTTP-Aufruf", "icon": "globe", "pro": true,
      "inputs": [{ "id": "in", "kind": "signal" }], "outputs": [{ "id": "out", "kind": "signal", "label": "danach" }],
      "fields": [{ "key": "method", "widget": "select", "label": "Methode", "default": "POST", "options": [["GET", "GET"], ["POST", "POST"]] },
                 { "key": "url", "widget": "text", "label": "Adresse (https://…)", "default": "", "max": 500, "required": true },
                 { "key": "body", "widget": "textarea", "label": "Inhalt (bei POST)", "default": "{flow}: {trigger}", "max": 2000, "when": { "method": "POST" } },
                 { "key": "allow_local", "widget": "toggle", "label": "Adresse im Heimnetz erlauben (ich vertraue dem Ziel)", "default": false }],
      "summary": "{method} {url}",
      "help": "Geht von ComfyOS aus ins Internet (ntfy, Pushover, Home Assistant …): Was du hier einträgst, verlässt dein Heimnetz. Adressen im Heimnetz sind gesperrt, bis du sie ausdrücklich erlaubst. Platzhalter: {trigger}, {device}, {value}, {flow}." },

    { "type": "set_flow", "category": "action", "label": "Flow an/aus", "icon": "toggle", "pro": true,
      "inputs": [{ "id": "in", "kind": "signal" }], "outputs": [{ "id": "out", "kind": "signal", "label": "danach" }],
      "fields": [{ "key": "flow", "widget": "flow", "label": "Flow" },
                 { "key": "to", "widget": "select", "label": "Schalten", "default": "off", "options": [["on", "einschalten"], ["off", "ausschalten"]] }],
      "summary": "{flow} {to}" },

    { "type": "set_var", "category": "action", "label": "Variable setzen", "icon": "tag", "pro": true,
      "inputs": [{ "id": "in", "kind": "signal" }], "outputs": [{ "id": "out", "kind": "signal", "label": "danach" }],
      "fields": [{ "key": "name", "widget": "var", "label": "Variable", "default": "Urlaub" },
                 { "key": "op", "widget": "select", "label": "Auf", "default": "on",
                   "options": [["on", "an (Ja)"], ["off", "aus (Nein)"], ["toggle", "umschalten"], ["set", "Zahl setzen"], ["add", "Zahl ändern (±)"], ["text", "Text setzen"]] },
                 { "key": "value", "widget": "number", "label": "Zahl", "default": 1, "step": 1, "when": { "op": ["set", "add"] } },
                 { "key": "text", "widget": "text", "label": "Text", "default": "", "max": 120, "when": { "op": "text" } },
                 { "key": "window", "widget": "duration", "label": "Zählfenster (0 = aus)", "default": 0, "min": 0, "max": 86400, "advanced": true, "when": { "op": "add" } }],
      "summary": "{name} {op} {value} {text}",
      "help": "Setzt eine Variable für alle Flows. Mit Zählfenster zählen nur die Schritte der letzten Zeit (gleitend) – z. B. dreimal in einer Minute. In Texten: {trigger}, {device}, {value}, {flow}." },

    { "type": "inspect", "category": "action", "label": "Inspektor", "icon": "eye", "pro": true,
      "inputs": [{ "id": "in", "kind": "signal" }], "outputs": [{ "id": "out", "kind": "signal", "label": "danach" }],
      "fields": [], "summary": "merkt den letzten Durchgang",
      "help": "Zeigt im Editor, wann und womit dieser Punkt zuletzt erreicht wurde." },

    { "type": "lock", "category": "action", "label": "Gerät sperren", "icon": "lock", "pro": true,
      "inputs": [{ "id": "in", "kind": "signal" }], "outputs": [{ "id": "out", "kind": "signal", "label": "danach" }],
      "fields": [{ "key": "do", "widget": "select", "label": "Aktion", "default": "lock", "options": [["lock", "sperren"], ["unlock", "entsperren"]] },
                 { "key": "target", "widget": "target", "label": "Geräte, Gruppen oder Räume" },
                 { "key": "switch", "widget": "select", "label": "Dabei schalten", "default": "keep", "options": [["keep", "nicht schalten"], ["on", "an"], ["off", "aus"]] }],
      "summary": "{target} {do}",
      "help": "Sperrt Geräte für ComfyOS (Oberfläche, Flows, Szenen schalten sie dann nicht mehr) oder hebt die Sperre auf. Dabei schalten setzt den Zustand auch bei einem bereits gesperrten Gerät – das darf nur dieser Baustein." },

    { "type": "notify", "category": "action", "label": "Benachrichtigung", "icon": "bell", "pro": true,
      "inputs": [{ "id": "in", "kind": "signal" }], "outputs": [{ "id": "out", "kind": "signal", "label": "danach" }],
      "fields": [{ "key": "text", "widget": "text", "label": "Text", "default": "{trigger}", "max": 200 },
                 { "key": "toast", "widget": "toggle", "label": "Als Hinweis in der geöffneten App", "default": true },
                 { "key": "push", "widget": "toggle", "label": "Als Push-Nachricht aufs Gerät", "default": false }],
      "summary": "{text}",
      "help": "Schreibt ins Ereignisprotokoll, zeigt auf Wunsch einen Hinweis in der App und schickt eine Push-Nachricht an alle Geräte, auf denen Benachrichtigungen eingeschaltet sind (System → Benachrichtigungen). Platzhalter: {trigger}, {device}, {value}, {flow}; in einer Schleife auch {index} und {count}." }
  ]
}
